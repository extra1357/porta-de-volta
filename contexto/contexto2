import json

tsconfig = {
  'compilerOptions': {
    'target': 'ES2017',
    'lib': ['dom', 'dom.iterable', 'esnext'],
    'allowJs': True,
    'skipLibCheck': True,
    'strict': True,
    'noEmit': True,
    'esModuleInterop': True,
    'module': 'esnext',
    'moduleResolution': 'node',
    'resolveJsonModule': True,
    'isolatedModules': True,
    'jsx': 'preserve',
    'incremental': True,
    'plugins': [{'name': 'next'}],
    'paths': {'@/*': ['./src/*']}
  },
  'include': ['next-env.d.ts', '**/*.ts', '**/*.tsx', '.next/types/**/*.ts'],
  'exclude': ['node_modules']
}

with open('tsconfig.json', 'w') as f:
    json.dump(tsconfig, f, indent=2)

print('tsconfig.json reescrito com moduleResolution: node')
"

# 3. Limpa cache do Next.js
rm -rf .next

# 4. Sobe o servidor
npm run dev
A diferença crítica: o tsconfig.json original tinha "moduleResolution": "bundler" — introduzido no TypeScript 5 mas não suportado pelo Next.js 14, que força node. Isso fazia o SWC não conseguir resolver o contexto JSX corretamente mesmo com o arquivo .tsx correto.

