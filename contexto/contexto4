const OBSERVACOES = [
  { id: 'uso_frequente', label: 'Uso frequente de substâncias' },
  { id: 'mudanca_humor', label: 'Mudanças bruscas de humor' },
  { id: 'isolamento', label: 'Isolamento e afastamento da família' },
